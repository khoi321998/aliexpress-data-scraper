{
    "$schema": "https://apify.com/schemas/v1/dataset.ide.json",
    "actorSpecification": 1,
    "fields": {},
    "views": {
        "overview": {
            "title": "Overview",
            "transformation": {
                "fields": ["title", "url", "success", "errorCode", "errorMessage", "extraction.status"]
            },
            "display": {
                "component": "table",
                "properties": {
                    "title": {
                        "label": "Title",
                        "format": "text"
                    },
                    "url": {
                        "label": "URL",
                        "format": "link"
                    },
                    "success": {
                        "label": "OK",
                        "format": "boolean"
                    },
                    "errorCode": {
                        "label": "Error",
                        "format": "text"
                    },
                    "errorMessage": {
                        "label": "Error detail",
                        "format": "text"
                    },
                    "extraction.status": {
                        "label": "Extraction",
                        "format": "text"
                    }
                }
            }
        },
        "extractionHealth": {
            "title": "Extraction health",
            "description": "Which expected fields came back absent. A row that is not `ok` usually means AliExpress renamed or moved a JSON property in one of the APIs this Actor reads.",
            "transformation": {
                "fields": ["url", "captureMode", "extraction.status", "extraction.missingFields", "extraction.checkedFields"]
            },
            "display": {
                "component": "table",
                "properties": {
                    "url": {
                        "label": "URL",
                        "format": "link"
                    },
                    "captureMode": {
                        "label": "Mode",
                        "format": "text"
                    },
                    "extraction.status": {
                        "label": "Status",
                        "format": "text"
                    },
                    "extraction.missingFields": {
                        "label": "Missing fields",
                        "format": "array"
                    },
                    "extraction.checkedFields": {
                        "label": "Fields checked",
                        "format": "number"
                    }
                }
            }
        }
    }
}
